{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edu-wallet-r2",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "cache": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "r2_buckets": [
    {
      "binding": "PRODUCTS",
      "bucket_name": "edu-wallet-products"
    }
  ]
}
